{
  "name": "pairs-trader",
  "version": "2.0.0",
  "private": true,
  "description": "Crypto perp trading toolkit for Hyperliquid: carry + trend portfolio book, statistical-arbitrage pairs, volume farming; research backtesters and a paper/live execution engine.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "fetch-data": "node bin/fetch-data.js",
    "scan": "node bin/scan.js",
    "backtest": "node bin/backtest.js",
    "research": "node bin/research.js",
    "engine": "node bin/engine.js",
    "serve": "node bin/serve.js",
    "test:py": "python -m unittest discover -s test/python",
    "farm-plan": "node bin/farm-plan.js",
    "portfolio": "node bin/portfolio.js",
    "strategies": "node bin/strategies.js"
  },
  "optionalDependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "viem": "2.57.5"
  }
}
