# Copy to .env (git-ignored) for live/testnet mode. Paper mode needs nothing.
# MAIN wallet address — used only to READ balances and positions.
HL_ACCOUNT=0xYourMainWalletAddress
# API (agent) wallet private key — create it at app.hyperliquid.xyz/API.
# It can place/cancel orders but cannot withdraw or transfer funds.
HL_AGENT_KEY=0xApiWalletPrivateKey
